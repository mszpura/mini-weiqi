{
	"name": "multi",
	"description": "",
	"version": "1.0.0",
	"type": "module",
	"private": true,
	"keywords": [
		"activity",
		"api",
		"discord",
		"embed",
		"embedded app",
		"http",
		"robo",
		"robo.js",
		"sdk",
		"server",
		"typescript",
		"vite",
		"web"
	],
	"scripts": {
		"build": "robo build && vite build --outDir .robo/public",
		"build:api": "robo build",
		"build:web": "vite build --outDir .robo/public",
		"deploy": "robo deploy",
		"dev": "npm run build:api && sh -c 'ROBO_SERVER_PORT=3001 NODE_ENV=production robo start & API_PID=$!; vite --host 0.0.0.0 --port 3000 --strictPort; EXIT_CODE=$?; kill $API_PID >/dev/null 2>&1; exit $EXIT_CODE'",
		"dev:tunnel": "npm run build:api && sh -c 'ROBO_SERVER_PORT=3001 NODE_ENV=production robo start & API_PID=$!; .robo/bin/cloudflared tunnel --url http://localhost:3000 & TUNNEL_PID=$!; vite --host 0.0.0.0 --port 3000 --strictPort; EXIT_CODE=$?; kill $TUNNEL_PID >/dev/null 2>&1; kill $API_PID >/dev/null 2>&1; exit $EXIT_CODE'",
		"doctor": "sage doctor",
		"invite": "robo invite",
		"lint:style": "prettier --write .",
		"start": "NODE_ENV=production robo start",
		"tunnel": ".robo/bin/cloudflared tunnel --url http://localhost:3000",
		"upgrade": "sage upgrade"
	},
	"dependencies": {
		"@discord/embedded-app-sdk": "^1.4.3",
		"@robojs/patch": "^0.2.1",
		"@robojs/server": "^0.6.6",
		"@robojs/sync": "^0.1.3",
		"@vitejs/plugin-react-swc": "^3.7.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"robo.js": "^0.10.32",
		"tenuki": "^0.3.1",
		"vite": "^5.4.8"
	},
	"optionalDependencies": {
		"@esbuild/linux-x64": "0.21.5",
		"@rollup/rollup-linux-x64-gnu": "4.22.5"
	},
	"devDependencies": {
		"@swc/core": "^1.7.26",
		"@types/node": "^22.7.4",
		"@types/react": "^18.3.10",
		"@types/react-dom": "^18.3.0",
		"discord.js": "14.22.1",
		"eslint-plugin-react-hooks": "^4.6.2",
		"prettier": "^3.3.3",
		"typescript": "^5.6.2"
	}
}
